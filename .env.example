# ─────────────────────────────────────────────────────────────────────────────
#  Kai — Environment Variables
#  Copy to .env and fill in your values before running locally.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Webhook Bearer Token (required)
# Generate a strong secret, e.g.: openssl rand -hex 32
WEBHOOK_SECRET=Password....

# ── Auth & Multi-Tenant ───────────────────────────────────────────────────────
# Google OAuth configuration for multi-user authentication
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Secret key used to sign JWT tokens (e.g. openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-key

# Secret key used for Starlette sessions during OAuth flow
SESSION_SECRET=your-session-secret-key

# ── Optional Overrides ────────────────────────────────────────────────────────
# EMBED_MODEL=text-embedding-3-small
