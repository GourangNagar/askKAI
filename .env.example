# ─────────────────────────────────────────────────────────────────────────────
#  Kai — Environment Variables
#  Copy to .env and fill in your values before running locally.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Webhook Bearer Token (required)
# Generate a strong secret, e.g.: openssl rand -hex 32
WEBHOOK_SECRET=Password....

# ── Optional Overrides ────────────────────────────────────────────────────────
# CHROMA_PERSIST_DIR=./chroma_db
# CHROMA_COLLECTION=kai_memory
# OPENAI_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
